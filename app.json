{
  "expo": {
    "name": "B:Scene",
    "slug": "bscene-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bscenemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bscene.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "B:Scene 라이브 방송을 위해 마이크 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "프로필 및 콘텐츠 촬영을 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 및 콘텐츠 이미지를 선택하기 위해 사진 접근 권한이 필요합니다.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.bscene.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F49E4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 85,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "B:Scene에서 이미지를 선택하기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "B:Scene에서 사진을 촬영하기 위해 카메라 권한이 필요합니다."
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "306c5e5f-7e6b-4f78-a355-4d7bf900db17"
      }
    }
  }
}
